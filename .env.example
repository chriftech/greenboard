# DEBUG picks where Firebase's web settings are read from (see lib/config.ts):
#   DEBUG=true  → the NEXT_PUBLIC_FIREBASE_* names (local development)
#   otherwise   → FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, … without the prefix (e.g. on Vercel)
# The server hands them to the browser when it renders the page; they're never baked into the JS bundle.
DEBUG=true

# Firebase web app settings, for accounts (login, signup, Google sign-in).
# Copy this file to .env.local and fill it in from:
#   Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
# These are public identifiers, not secrets. Leave them empty to run in guest mode only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# With DEBUG off, set the same six values under these names instead:
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=

# ───────────── Branded verification email (optional, server-only SECRETS) ─────────────
# With these set, sign-up sends greenboard's own verification email (emails/verify-email.html)
# through Resend. Without them, Firebase's standard email is sent instead.
# No NEXT_PUBLIC_ prefix: these stay on the server. Never commit real values.

# Firebase console → Project settings → Service accounts → Generate new private key.
# From the downloaded JSON: "client_email", and "private_key" pasted on one line in quotes,
# keeping its \n sequences as they are. (FIREBASE_ADMIN_PROJECT_ID defaults to the Firebase project ID above.)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_ADMIN_PROJECT_ID=

# How to send: SMTP (used when set) or Resend.
#
# Mailtrap Email Testing (sandbox): catches every email in a Mailtrap inbox instead of
# delivering it, so it's safe for development. Mailtrap → Email Testing → Inboxes → your inbox
# → Integration → SMTP for the username and password.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
#
# Other SMTP servers work the same way, e.g.:
#   Mailtrap Email Sending (real delivery, needs a verified domain): live.smtp.mailtrap.io, port 587,
#     user "api", password = your Mailtrap API token
#   Gmail: smtp.gmail.com, port 465, your address, and an app password from
#     https://myaccount.google.com/apppasswords (needs 2-Step Verification; ~500 emails a day)
#
# Or Resend (resend.com → API Keys), sending from a domain you've verified there.
# RESEND_API_KEY=
#
# The sender. The Mailtrap sandbox accepts any address; with Gmail, use the same address as SMTP_USER;
# with real sending services, use an address on your verified domain.
EMAIL_FROM="greenboard <hello@greenboard.test>"
# EMAIL_REPLY_TO=support@yourdomain.com

# Optional: the site's public address, for the "Continue" link after confirming
# (defaults to the address the request came in on).
# APP_URL=https://yourdomain.com

# Optional, for local testing against the Firebase Auth emulator (only read when DEBUG=true)
# (npx firebase-tools emulators:start --only auth --project demo-greenboard):
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
